+     */
+    private static final float POCKET_LIGHT_MAX_THRESHOLD = 3.0f;
+
+    private final ArrayList<IPocketCallback> mCallbacks= new ArrayList<>();
+
+    private Context mContext;
+    private boolean mEnabled;
+    private boolean mSystemReady;
